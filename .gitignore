# Third-party reference source. Reproduce with the script in
# references/code/README.md. The two README.md files ARE tracked.
references/code/*
!references/code/README.md

# Publisher PDFs. Copyrighted, never committed, never pushed.
references/papers/*
!references/papers/README.md

# Journal supplementary material. Same rule as the PDFs above, and it was not
# covered by them. references/Fleissig-Whitney_JBES.xls, supplementary material
# to Fleissig & Whitney (2003), was tracked from the second commit and was
# removed from the entire history on 2026-08-30, immediately before this
# repository was first pushed public. The file stays on disk; it is only out of
# git. Do not add it back.
references/*.xls
references/*.xlsx

# R
.Rproj.user
.Rhistory
.RData
.Ruserdata
*.Rproj
.Renviron

# Build artefacts
*.tar.gz
*.Rcheck/
src/*.o
src/*.so
src/*.dll
inst/doc
docs/

# macOS
.DS_Store
